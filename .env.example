# Copy to .env. Nothing here is a secret by default; there is NO default admin account.
VEYLSTREAM_DATA_DIR=./data/runtime
# VEYLSTREAM_DB=./data/runtime/veylstream.sqlite
VEYLSTREAM_HOST=127.0.0.1
VEYLSTREAM_PORT=8080
# 1 = fsync the log before acknowledging ingestion (durable). 0 = faster, acks are NOT crash-durable.
VEYLSTREAM_FSYNC=1
# Webhooks to private/loopback addresses are blocked unless this is 1 (leave 0 in production).
VEYLSTREAM_ALLOW_PRIVATE_WEBHOOKS=0
# Comma-separated browser origins allowed for cross-origin API calls (empty = same-origin only).
VEYLSTREAM_CORS_ORIGINS=
# Used only by `setup-demo`; if the password is omitted a random one is generated and printed once.
VEYLSTREAM_ADMIN_EMAIL=admin@veylstream.local
# VEYLSTREAM_ADMIN_PASSWORD=
# Optional e-mail notifications
# VEYLSTREAM_SMTP_HOST=
